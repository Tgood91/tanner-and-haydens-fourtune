-- ============================================================
-- VENDOR CLASS
-- ============================================================
local Vendor = {}
Vendor.__index = Vendor

function Vendor:new(name, location, type, inventory)
    local self = setmetatable({}, Vendor)
    self.name = name
    self.location = location
    self.type = type -- "gunshop", "food", "medical", "tools", "black_market"
    self.inventory = inventory or {}
    self.cash = 50000
    self.reputation = 100
    self.openTime = 0 -- 24h format
    self.closeTime = 23
    self.lastRestock = 0
    self.markup = 1.2 -- 20% markup standard
    self.urgencyMultiplier = 1.0
    return self
end

function Vendor:isOpen(hour)
    hour = hour or 12
    return hour >= self.openTime and hour < self.closeTime
end

function Vendor:getStock(itemName)
    return self.inventory[itemName] or 0
end

function Vendor:setStock(itemName, quantity)
    self.inventory[itemName] = math.max(0, quantity)
end

function Vendor:addCash(amount)
    self.cash = self.cash + amount
end

function Vendor:subtractCash(amount)
    if self.cash >= amount then
        self.cash = self.cash - amount
        return true
    end
    return false
end

