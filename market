-- ============================================================
-- PRICING ENGINE
-- ============================================================
local PricingEngine = {}

function PricingEngine:calculateBuyPrice(itemKey, vendor, playerRep, supplyLevel)
    local item = ItemDB[itemKey]
    if not item then return 0 end
    
    local basePrice = item.basePrice
    supplyLevel = supplyLevel or vendor:getStock(itemKey)
    
    -- Scarcity multiplier: low stock = higher price
    local scarcityMult = 1.0
    if supplyLevel == 0 then
        scarcityMult = 2.0 -- Can't buy, but price doubles if restocked
    elseif supplyLevel < 3 then
        scarcityMult = 1.5
    elseif supplyLevel > 20 then
        scarcityMult = 0.85 -- Overstock discount
    end
    
    -- Reputation discount (negative rep = you pay more)
    -- Every 10 rep points = 1% discount. Max 15% off at +150 rep
    local repMult = 1.0 - math.min(0.15, (playerRep / 10) * 0.01)
    repMult = math.max(0.85, repMult) -- Floor at 85% (max 15% off)
    
    -- Vendor markup
    local vendorMarkup = vendor.markup
    
    -- Global market conditions
    local globalMult = Marketplace.globalPriceMultiplier
    
    local finalPrice = basePrice * vendorMarkup * scarcityMult * repMult * globalMult
    return math.ceil(finalPrice)
end

function PricingEngine:calculateSellPrice(itemKey, vendor, playerRep, condition)
    local item = ItemDB[itemKey]
    if not item then return 0 end
    
    local basePrice = item.basePrice
    condition = condition or 1.0 -- 1.0 = perfect, 0.5 = half condition
    
    -- Vendors buy back at ~40% of buy price
    local buyPrice = self:calculateBuyPrice(itemKey, vendor, playerRep, vendor:getStock(itemKey))
    local sellPrice = math.ceil(buyPrice * 0.4 * condition)
    
    -- Vendor will only buy if they have cash
    if vendor.cash < sellPrice then
        sellPrice = math.ceil(vendor.cash * 0.8)
    end
    
    return math.max(0, sellPrice)
end

-- ============================================================
-- TRANSACTION SYSTEM
-- ============================================================
local TransactionLog = {}

function TransactionLog:new(tType, player, vendor, itemKey, quantity, priceEach, timestamp)
    local tx = {
        type = tType, -- "buy", "sell"
        player = player,
        vendor = vendor,
        itemKey = itemKey,
        itemName = ItemDB[itemKey].name,
        quantity = quantity,
        priceEach = priceEach,
        totalPrice = priceEach * quantity,
        timestamp = timestamp or os.time(),
    }
    return tx
end

-- ============================================================
-- MARKETPLACE INTERFACE
-- ============================================================

function Marketplace:registerVendor(vendor)
    table.insert(self.vendors, vendor)
end

function Marketplace:findVendor(name)
    for _, vendor in ipairs(self.vendors) do
        if vendor.name == name then return vendor end
    end
    return nil
end

function Marketplace:buyFromVendor(playerName, vendorName, itemKey, quantity)
    local vendor = self:findVendor(vendorName)
    if not vendor then
        return { success = false, reason = "Vendor not found: " .. vendorName }
    end
    
    -- Check vendor has stock
    if vendor:getStock(itemKey) < quantity then
        return { success = false, reason = string.format(
            "%s only has %d in stock (you want %d)",
            vendor.name, vendor:getStock(itemKey), quantity
        ) }
    end
    
    -- Calculate price
    local priceEach = PricingEngine:calculateBuyPrice(itemKey, vendor, self.playerReputation)
    local totalPrice = priceEach * quantity
    
    -- Execute transaction
    vendor:setStock(itemKey, vendor:getStock(itemKey) - quantity)
    vendor:addCash(totalPrice)
    
    -- Log it
    local tx = TransactionLog:new("buy", playerName, vendor.name, itemKey, quantity, priceEach)
    table.insert(self.transactions, tx)
    
    return {
        success = true,
        itemName = ItemDB[itemKey].name,
        quantity = quantity,
        priceEach = priceEach,
        totalPrice = totalPrice,
        vendorName = vendor.name
    }
end

function Marketplace:sellToVendor(playerName, vendorName, itemKey, quantity, condition)
    local vendor = self:findVendor(vendorName)
    if not vendor then
        return { success = false, reason = "Vendor not found: " .. vendorName }
    end
    
    condition = condition or 1.0
    
    -- Calculate price
    local priceEach = PricingEngine:calculateSellPrice(itemKey, vendor, self.playerReputation, condition)
    local totalPrice = priceEach * quantity
    
    -- Check vendor has cash
    if not vendor:subtractCash(totalPrice) then
        return { success = false, reason = string.format(
            "%s only has $%d (you want $%d)",
            vendor.name, vendor.cash, totalPrice
        ) }
    end
    
    -- Execute transaction
    vendor:setStock(itemKey, vendor:getStock(itemKey) + quantity)
    
    -- Log it
    local tx = TransactionLog:new("sell", playerName, vendor.name, itemKey, quantity, priceEach)
    table.insert(self.transactions, tx)
    
    return {
        success = true,
        itemName = ItemDB[itemKey].name,
        quantity = quantity,
        priceEach = priceEach,
        totalPrice = totalPrice,
        vendorName = vendor.name
    }
end

function Marketplace:getVendorCatalog(vendorName)
    local vendor = self:findVendor(vendorName)
    if not vendor then return nil end
    
    local catalog = {}
    for itemKey, stock in pairs(vendor.inventory) do
        if stock > 0 then
            local item = ItemDB[itemKey]
            local buyPrice = PricingEngine:calculateBuyPrice(itemKey, vendor, self.playerReputation)
            table.insert(catalog, {
                itemKey = itemKey,
                itemName = item.name,
                stock = stock,
                price = buyPrice,
                category = item.category
            })
        end
    end
    
    table.sort(catalog, function(a, b)
        return a.itemName < b.itemName
    end)
    
    return catalog
end

function Marketplace:printVendorCatalog(vendorName)
    local vendor = self:findVendor(vendorName)
    if not vendor then
        print("ERROR: Vendor not found")
        return
    end
    
    print("\n╔════════════════════════════════════════════════╗")
    print("║ " .. string.format("%-45s", vendor.name .. " — " .. vendor.location) .. " ║")
    print("╠════════════════════════════════════════════════╣")
    
    local catalog = self:getVendorCatalog(vendorName)
    if #catalog == 0 then
        print("║ (out of stock) ║")
    else
        for _, item in ipairs(catalog) do
            local line = string.format(
                "║ %-30s $%-8d [%d] ║",
                item.itemName:sub(1, 30),
                item.price,
                item.stock
            )
            print(line)
        end
    end
    
    print("╠════════════════════════════════════════════════╣")
    print(string.format("║ Vendor Cash: $%-37d ║", vendor.cash))
    print("╚════════════════════════════════════════════════╝\n")
end

function Marketplace:printTransactionHistory(count)
    count = count or 10
    print("\n--- Recent Transactions (last " .. count .. ") ---")
    
    local start = math.max(1, #self.transactions - count + 1)
    for i = start, #self.transactions do
        local tx = self.transactions[i]
        local action = tx.type == "buy" and "BOUGHT" or "SOLD"
        print(string.format(
            "[%s] %s %d x %s @ $%d each = $%d (via %s)",
            action, tx.player, tx.quantity, tx.itemName, tx.priceEach, tx.totalPrice, tx.vendor
        ))
    end
    print()
end

function Marketplace:updateReputation(delta)
    self.playerReputation = self.playerReputation + delta
    print(string.format("Reputation: %+d (now %d)", delta, self.playerReputation))
end

