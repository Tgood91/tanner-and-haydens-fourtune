               background: rgba(70, 62, 55, .45); border: 2px dashed rgba(40,36,32,.5);
               border-radius: 34% 30% 36% 30% / 40% 38% 42% 38%; }
  .peach-ridge-park { left: 15%;  top: 78%; width: 5%; }
  .groveland-park   { left: 32.5%; top: 64.6%; width: 5%; }     /* full size, outside the downtown: north of the Perimeter, below Red Clay */

  /* ============================================================
     ROADS — one base class, then each road
     ============================================================ */
