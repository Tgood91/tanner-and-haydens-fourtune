  .westside-run { left: 7%;  top: 71%; width: 24%; height: 1.8%; transform: rotate(-4deg); }                      /* Westside Run */
  .peachline    { left: 18%; top: 73%; width: 26%; height: 1.6%; transform: rotate(3deg); }                       /* Peachline Road */
  .drive        { left: 62%; top: 77.3%; width: 13.2%; height: 1.7%; transform: rotate(-7deg); background: #efe9dc; } /* Highfield Park Drive — ends at the shore */
  .harbor-road  { left: 74.6%; top: 76.85%; width: 5.8%; height: 1.5%; transform: rotate(52deg); transform-origin: left center; background: #efe9dc; } /* the Drive on down onto the 1017 Harbor quay */
  .primrose     { left: 69.6%; top: 78.6%; width: .9%; height: 10.6%; background: #e6dfcf; } /* Primrose Street — south off Highfield Park Drive, past the east towers */
