<style>
  /* ============================================================
     SOLID MAP — the Fourtune world drawn in pure CSS.
     No image files at all: water, land, roads, districts and
     labels are styled boxes, blobs (border-radius), rings and
     clip-path polygons. Schematic — it shows the world's shape
     (312 north, country between, 1017 south), not walked coords.
     Only markings on the map itself: the area codes, as always.

     TAMPER GUIDE — every feature is one class, one <div>:
       left / top     move it (% of the map, from the top-left)
       width / height resize it
       rotate()       tilt it (roads)
       Delete the <div> in the body and the feature is gone.
       Add a <div class="road yourname"> + a .yourname rule
       and you've drawn a new road.
     ============================================================ */

  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0b1526; font-family: Arial, Helvetica, sans-serif;
         display: flex; flex-direction: column; align-items: center; padding: 24px 12px; }
  h1 { color: #e8eef7; font-size: 20px; letter-spacing: 2px; margin-bottom: 4px; }
  p.note { color: #8fa5c0; font-size: 13px; margin-bottom: 16px; }

  /* ---- the plate: open water ---- */
  .map { position: relative; width: min(94vw, 860px); aspect-ratio: 4 / 5;   /* big enough for the downtown towers */
         background: linear-gradient(160deg, #17456e, #0d2c4c 70%);
         border-radius: 18px; overflow: hidden;
         box-shadow: 0 18px 50px rgba(0,0,0,.55); }

  /* ---- the island: one solid landmass, clipped to shape ---- */
  .land { position: absolute; inset: 3% 6%;
          background: linear-gradient(180deg, #9aa578 0%, #a8ad7d 34%, #b3a877 55%, #8f9a72 78%, #7d8f6d 100%);
          clip-path: polygon(38% 1%, 63% 3%, 72% 13%, 79% 30%, 74% 47%, 83% 65%, 77% 84%, 64% 98%, 35% 99%, 21% 87%, 19% 64%, 13% 44%, 19% 24%, 27% 10%); }

  /* ---- the lake biting into the 312 ---- */
  .lake { position: absolute; top: -4%; right: -6%; width: 46%; height: 26%;
          background: linear-gradient(200deg, #1a4d78, #123a5f);
          border-radius: 46% 0 30% 62% / 60% 0 40% 55%; }

  /* ---- districts + parks: shared bases, one class per place ---- */
  .district { position: absolute; background: rgba(255,255,255,.10);
              border: 2px dashed rgba(30,30,30,.35);
              border-radius: 38% 34% 40% 34% / 44% 40% 44% 40%; }
  .park { position: absolute; background: rgba(64,120,58,.65);
          border: 2px solid rgba(30,60,28,.5); border-radius: 50%; aspect-ratio: 1; }

  /* ============================================================
     312 — CHICAGO, the northern plate
     ============================================================ */
  .knot      { left: 17%; top: 5%;  width: 20%; height: 11%; }
  .midway    { left: 33%; top: 4%;  width: 20%; height: 10%; }
  .northline { left: 48%; top: 2%;  width: 21%; height: 10%; }
  .shoreline { left: 58%; top: 11%; width: 19%; height: 11%; }
  .winterline-park { left: 40%; top: 13%; width: 6%; }
  .harbor-green    { left: 62%; top: 19%; width: 5%; }

  /* ============================================================
     770 — GEEPEE, the country between
     ============================================================ */
  .farms { position: absolute; left: 16%; top: 36%; width: 62%; height: 24%;
           background: repeating-linear-gradient(93deg, rgba(214,188,110,.35) 0 22px, rgba(148,160,94,.35) 22px 44px);
           border-radius: 40% 46% 44% 40% / 30% 34% 30% 32%; }
  .mountain { position: absolute; left: 36%; top: 35%; width: 27%; height: 17%;
              background: linear-gradient(180deg, #8d8578, #6e675c);
              clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .mountain::after { content: ""; position: absolute; left: 38%; top: 0; width: 24%; height: 34%;
              background: #e9e9e4; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .backroads-district { right: 13%; top: 32%; width: 26%; height: 11%; }
  .harvest-flats      { right: 9%;  top: 47%; width: 24%; height: 12%; }
  .harvest-common     { right: 20%; top: 55%; width: 5.5%; }

  /* ============================================================
     1017 — ATLANTA, the southern plate
     ============================================================ */
  .red-clay      { left: 33%; top: 63%; width: 22%; height: 10%; }
  .alder-heights { left: 18%; top: 67%; width: 20%; height: 10%; }
  .westside      { left: 11%;  top: 64%; width: 19%; height: 13%; }
  .southline     { left: 27%; top: 85%; width: 22%; height: 9%; }
  .highfield { position: absolute; right: 13%; bottom: 17%; width: 27%; height: 15%;
               background: rgba(70, 62, 55, .45); border: 2px dashed rgba(40,36,32,.5);
               border-radius: 34% 30% 36% 30% / 40% 38% 42% 38%; }
  .peach-ridge-park { left: 15%;  top: 78%; width: 5%; }
  .groveland-park   { left: 55.5%; top: 88.9%; width: 3.6%; }   /* below the east towers, clear of every roof */

  /* ============================================================
     ROADS — one base class, then each road
     ============================================================ */
  .road { position: absolute; z-index: 1; background: #d9d9d4; border-radius: 6px;
          box-shadow: 0 0 0 1px rgba(60,60,60,.35); }
  .ring { position: absolute; z-index: 1; border: solid #d9d9d4; border-radius: 50%;
          box-shadow: 0 0 0 1px rgba(60,60,60,.35), inset 0 0 0 1px rgba(60,60,60,.35); }

  /* the spine + the country */
  .connector { left: 47%; top: 15%; width: 2.4%; height: 61%; }                    /* 1017 up through the country */
  .backroads { left: 33%; top: 46%; width: 34%; height: 1.8%; transform: rotate(-24deg); transform-origin: left center; }
  .backroads-hwy { right: 17%; top: 33%; width: 2.2%; height: 27%; transform: rotate(10deg); }  /* Backroads Highway */
  .county-line   { left: 20%; top: 40%; width: 55%; height: 1.6%; }                              /* County Line Road */

  /* 312 roads */
  .lakeshore { right: 19%; top: 7%;  width: 2.2%; height: 21%; transform: rotate(14deg); border-radius: 50%; }  /* Lakeshore Drive */
  .skyway    { left: 17%; top: 12%; width: 30%; height: 1.8%; transform: rotate(9deg); }                          /* The 312 Skyway */
  .ironline   { left: 20%; top: 6%;  width: 2.2%; height: 22%; transform: rotate(-4deg); }                          /* Ironline Expressway */
  .causeway  { right: 5%; top: 16%; width: 21%; height: 1.8%; transform: rotate(18deg); }                          /* The Causeway */
  .palisade  { left: 20%; top: 23%; width: 34%; height: 1.7%; }                                                   /* Palisade Boulevard */
  .knot-loop { left: 16%; top: 4%;  width: 15%; height: 10%; border-width: 5px; }                                 /* Knot Loop */

  /* 1017 roads */
  .perimeter { left: 24%; bottom: 6%; width: 52%; height: 26%; border-width: 9px; }                               /* The Perimeter */
  .red-clay-xwy { left: 31%; top: 62%; width: 30%; height: 1.8%; transform: rotate(6deg); }                       /* Red Clay Expressway */
  .westside-run { left: 7%;  top: 71%; width: 24%; height: 1.8%; transform: rotate(-4deg); }                      /* Westside Run */
  .peachline    { left: 18%; top: 73%; width: 26%; height: 1.6%; transform: rotate(3deg); }                       /* Peachline Road */
  .drive        { right: 14%; bottom: 21.5%; width: 24%; height: 1.7%; transform: rotate(-7deg); background: #efe9dc; } /* Highfield Park Drive */

  /* ---- the 312 port + the 1017 airport ---- */
  .port { position: absolute; top: 4.5%; right: 15%; width: 15%; height: 4%;
          background: repeating-linear-gradient(90deg, #7c7f82 0 10px, #5f6265 10px 20px); border-radius: 3px; }
  .airport { position: absolute; left: 18%; bottom: 1.8%; width: 64%; height: 4.6%;
             background: #565a5e; border-radius: 3px; }
  .airport::after { content: ""; position: absolute; left: 3%; right: 3%; top: 46%; height: 8%;
             background: repeating-linear-gradient(90deg, #f2f2f2 0 14px, transparent 14px 28px); }

  /* ---- downtown cores ---- */
  .core { position: absolute; background: #6c7177; border-radius: 4px; opacity: .85; }   /* downtown pavement */
  .core-north { left: 22.6%; top: 8.2%; width: 34.4%; height: 15%; }   /* grown to hold the extra towers */
  .core-south { left: 29%; top: 75%; width: 39.5%; height: 13.6%; }   /* grown to hold the extra towers */

  /* ---- downtown towers: every one 25 floors or more. --floors sets the height:
     the taller the tower, the longer its shadow to the south-east. Hover for floors. ---- */
  .highrise { position: absolute; z-index: 2; border-radius: 2px;
           background: linear-gradient(135deg, #b9c0c8, #8f979f);
           border: 1px solid rgba(30,34,40,.55);
           box-shadow: calc(var(--floors) * .14px) calc(var(--floors) * .14px) 0 rgba(20,24,30,.45),
                       calc(var(--floors) * .2px) calc(var(--floors) * .2px) 6px rgba(0,0,0,.25); }
  .highrise::after { content: ""; position: absolute; inset: 22%; border: 1px solid rgba(40,44,50,.35); }
