  /* ============================================================
     DOCKS + SHIPS — the 312 Port on the lake, the 1017 Harbor on
     the east bay. Piers are plain decks; cranes are yellow gantries;
     ships are hulls with a pointed bow (clip-path) and a deck load.
     ============================================================ */
  .pier-deck { position: absolute; z-index: 1; background: #8a7d6b; border: 1px solid rgba(40,32,24,.5);
               border-radius: 2px; box-shadow: 0 2px 4px rgba(0,0,0,.35); }
  .quay { position: absolute; z-index: 1; background: #9a9590; border: 1px solid rgba(40,40,40,.45); border-radius: 3px; }
  .containers { position: absolute; z-index: 2; border-radius: 1px; opacity: .95;
                background: repeating-linear-gradient(90deg, #c0392b 0 9%, #2e86c1 9% 18%, #e67e22 18% 27%,
                            #27ae60 27% 36%, #8e44ad 36% 45%, #d4ac0d 45% 54%); }
  .crane { position: absolute; z-index: 3; width: 1.5%; aspect-ratio: 1; background: #f2c230;
           border: 1px solid #7a5d0a; border-radius: 2px; }
  .crane::after { content: ""; position: absolute; left: 40%; top: -160%; width: 20%; height: 260%;
                  background: #f2c230; border: 1px solid #7a5d0a; }                   /* the boom, out over the water */
  .crane.east::after { left: 100%; top: 40%; width: 260%; height: 20%; }
  .ship { position: absolute; z-index: 2; background: linear-gradient(180deg, #3b4652, #232a33);
          clip-path: polygon(0 0, 82% 0, 100% 50%, 82% 100%, 0 100%);
          box-shadow: 0 0 0 1px rgba(0,0,0,.4); }
  .ship::after { content: ""; position: absolute; left: 8%; right: 24%; top: 22%; bottom: 22%;
                 background: repeating-linear-gradient(90deg, #c0392b 0 12%, #2e86c1 12% 24%, #e67e22 24% 36%, #27ae60 36% 48%); }
  .ship.tanker::after { background: #b03a2e; border-radius: 40%; left: 10%; right: 26%; }
  .ship.ferry { background: linear-gradient(180deg, #f4f4f0, #c9ccd0); }
  .ship.ferry::after { background: repeating-linear-gradient(90deg, #2b3a4a 0 6%, transparent 6% 12%); top: 35%; bottom: 35%; }
  .wake { position: absolute; z-index: 1; height: .5%; border-radius: 50%;
          background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.55)); }

