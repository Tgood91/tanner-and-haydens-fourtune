<style>
  /* ============================================================
     SOLID MAP — the Fourtune world drawn in pure CSS.
     No image files at all: water, land, roads, districts and
     labels are styled boxes, blobs (border-radius), rings and
     clip-path polygons. Schematic — it shows the world's shape
     (312 north, country between, 1017 south), not walked coords.
     Only markings on the map itself: the area codes, as always.

     TAMPER GUIDE — every feature is one class, one <div>:
       left / top     move it (% of the map, from the top-left)
       width / height resize it
       rotate()       tilt it (roads)
       Delete the <div> in the body and the feature is gone.
       Add a <div class="road yourname"> + a .yourname rule
       and you've drawn a new road.
     ============================================================ */

  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #0b1526; font-family: Arial, Helvetica, sans-serif;
         display: flex; flex-direction: column; align-items: center; padding: 24px 12px; }
  h1 { color: #e8eef7; font-size: 20px; letter-spacing: 2px; margin-bottom: 4px; }
  p.note { color: #8fa5c0; font-size: 13px; margin-bottom: 16px; }

  /* ---- the plate: open water ---- */
  .map { position: relative; width: min(96vw, 1400px); aspect-ratio: 4 / 5;   /* large: room for detail; shrinks to fit small screens */
         background: linear-gradient(160deg, #17456e, #0d2c4c 70%);
         border-radius: 18px; overflow: hidden;
         box-shadow: 0 18px 50px rgba(0,0,0,.55); }

  /* ---- the island: one solid landmass, clipped to shape ---- */
  .land { position: absolute; inset: 3% 6%;
          background: linear-gradient(180deg, #9aa578 0%, #a8ad7d 34%, #b3a877 55%, #8f9a72 78%, #7d8f6d 100%);
          clip-path: polygon(38% 1%, 63% 3%, 72% 13%, 79% 30%, 74% 47%, 83% 65%, 77% 84%, 64% 98%, 35% 99%, 21% 87%, 19% 64%, 13% 44%, 19% 24%, 27% 10%); }

  /* ---- the lake biting into the 312 ---- */
  .lake { position: absolute; top: -4%; right: -6%; width: 46%; height: 26%;
          background: linear-gradient(200deg, #1a4d78, #123a5f);
          border-radius: 46% 0 30% 62% / 60% 0 40% 55%; }

  /* ---- districts + parks: shared bases, one class per place ---- */
  .district { position: absolute; background: rgba(255,255,255,.10);
              border: 2px dashed rgba(30,30,30,.35);
              border-radius: 38% 34% 40% 34% / 44% 40% 44% 40%; }
  .park { position: absolute; background: rgba(64,120,58,.65);
          border: 2px solid rgba(30,60,28,.5); border-radius: 50%; aspect-ratio: 1; }

  /* ============================================================
     312 — CHICAGO, the northern plate
     ============================================================ */
  .knot      { left: 17%; top: 5%;  width: 20%; height: 11%; }
  .midway    { left: 33%; top: 4%;  width: 20%; height: 10%; }
  .northline { left: 48%; top: 2%;  width: 21%; height: 10%; }
  .shoreline { left: 58%; top: 11%; width: 19%; height: 11%; }
  .winterline-park { left: 40%; top: 13%; width: 6%; }
  .harbor-green    { left: 62%; top: 19%; width: 5%; }

  /* ============================================================
     770 — GEEPEE, the country between
     ============================================================ */
  .farms { position: absolute; left: 16%; top: 36%; width: 62%; height: 24%;
           background: repeating-linear-gradient(93deg, rgba(214,188,110,.35) 0 22px, rgba(148,160,94,.35) 22px 44px);
           border-radius: 40% 46% 44% 40% / 30% 34% 30% 32%; }
  .mountain { position: absolute; left: 36%; top: 35%; width: 27%; height: 17%;
              background: linear-gradient(180deg, #8d8578, #6e675c);
              clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .mountain::after { content: ""; position: absolute; left: 38%; top: 0; width: 24%; height: 34%;
              background: #e9e9e4; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .backroads-district { right: 13%; top: 32%; width: 26%; height: 11%; }
  .harvest-flats      { right: 9%;  top: 47%; width: 24%; height: 12%; }
  .harvest-common     { right: 20%; top: 55%; width: 5.5%; }

  /* ============================================================
     1017 — ATLANTA, the southern plate
     ============================================================ */
