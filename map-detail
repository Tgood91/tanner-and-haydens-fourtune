  .skyway    { left: 17%; top: 12%; width: 30%; height: 1.8%; transform: rotate(9deg); }                          /* The 312 Skyway */
  .ironline   { left: 20%; top: 6%;  width: 2.2%; height: 22%; transform: rotate(-4deg); }                          /* Ironline Expressway */
