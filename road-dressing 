  .dashed-v::after { content: ""; position: absolute; top: 3%; bottom: 3%; left: 50%; width: 2px; margin-left: -1px;
          background: repeating-linear-gradient(180deg, #fff 0 8px, transparent 8px 16px); opacity: .8; }
  .shoulder { position: absolute; background: rgba(196,178,132,.75); border-radius: 8px; }  /* gravel under the dirt routes */
  .hairpin { position: absolute; left: 57%; top: 35.5%; width: 9%; height: 7%;
          border: 5px solid #d9d9d4; border-bottom: none; border-radius: 50% 50% 0 0;
          box-shadow: 0 -1px 0 rgba(60,60,60,.35); }                                        /* switchback on Fuugee's slope */
  .pothole { position: absolute; width: 2.3%; aspect-ratio: 1.4; border-radius: 50%; z-index: 3;
