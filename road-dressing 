          box-shadow: inset 0 2px 3px rgba(0,0,0,.65); }
  .crack { position: absolute; height: 2px; background: rgba(40,38,35,.55); border-radius: 2px; z-index: 3; }
  .junction { position: absolute; width: 2.6%; aspect-ratio: 1; background: #f5f2e8; z-index: 3;
          border: 2px solid rgba(60,60,60,.4); border-radius: 50%; }
  .cone { position: absolute; width: 2.4%; aspect-ratio: .8; z-index: 3;
