local inventory = {
    water = 1,
    sandwich = 1,
}

local function useItem(inv, item)
    if inv[item] and inv[item] > 0 then
        inv[item] = inv[item] - 1
        return "Used a " .. item
    else
        return "You don't have a " .. item
    end
end

print(useItem(inventory, "water"))
